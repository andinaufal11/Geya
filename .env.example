# Public canonical origin used during production builds (no trailing path).
SITE_URL=https://geya.vercel.app

# Server-only. Never prefix secrets with VITE_. Enable only after setting all production credentials.
CHAT_AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Shared counters are required for AI on Vercel/production. Create an Upstash Redis database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CHAT_REQUESTS_PER_10_MIN=10
CHAT_DAILY_LIMIT=100
# Optional dedicated HMAC salt for IP counter identifiers (otherwise the API key is used).
CHAT_RATE_LIMIT_SALT=